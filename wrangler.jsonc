{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decanteassil",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  "main": "server/worker.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "decanteassil-store",
    },
  ],
}
